# Copy to .env and fill in. NEVER commit the real .env.
BASE_URL=https://api.example.com

# Session file (stores cookies/tokens/device between runs)
SESSION_FILE=session.json

# Captcha (optional) — see docs/captcha-solvers.md
CAPTCHA_PROVIDER=capsolver        # capsolver | ezcaptcha | capzy | 2captcha | nextcaptcha
CAPTCHA_API_KEY=

# TLS impersonation profile for curl_cffi (match the real app/browser)
IMPERSONATE=chrome
